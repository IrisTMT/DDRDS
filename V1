local sensor = peripheral.wrap("left")
local laser = peripheral.wrap("right")

local targets = {
    "Creeper",
    "Zombie",
    "Zombie Villager",
    "Skeleton",
    "Pillager",
    "Spider",
    "Cave Spider",
    "Witch",
    "Enderman",
    "Emma",
    "ivcr",
    "Breeze",
    "Stray",
    "Husk"
}

function table.contains(table, value)
    for i = 1, #table do
        if (table[i] == value) then
            return true
        end
    end

    return false
end

while true do
    turtle.turnLeft()
        for _, entity in pairs(sensor.sense()) do
            if table.contains(targets, entity.name) then
                local x, y, z = entity.x, entity.y, entity.z
                local pitch = -math.atan2(y, math.sqrt(x * x + z * z))
                local yaw = math.atan2(-x, z)

                laser.fire(math.deg(yaw), math.deg(pitch), 5, false)
                sleep(0.1)
            end
        end
    end
